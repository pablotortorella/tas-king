{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "homesuite-site",
  "workers_dev": true,
  "routes": [
    { "pattern": "homesuite.info", "custom_domain": true },
    { "pattern": "www.homesuite.info", "custom_domain": true }
  ],
  "main": "./src/index.js",
  "compatibility_date": "2026-06-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "env": {
    "staging": {
      "name": "homesuite-site-staging",
      "workers_dev": true,
      "routes": [{ "pattern": "site-staging.homesuite.info", "custom_domain": true }],
      "vars": { "SITE_ENV": "staging" },
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": true
      }
    }
  }
}
