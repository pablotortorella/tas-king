{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "homesuite-app",
  "main": "./src/index.js",
  "compatibility_date": "2026-06-30",
  // Archivos estáticos propios (hoy sólo Remanso). Sin `run_worker_first`: todo el
  // HTML lo genera el Worker, así que la política y las cabeceras llegan al
  // documento (ADR-017). NUNCA poner un .html en ./public: capturaría su ruta
  // sin pasar por el Worker. Lo vigila apps/app/test/remanso-assets.test.js.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "homesuite-app-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "./migrations"
  }],
  "env": {
    "staging": {
      "name": "homesuite-app-staging",
      "workers_dev": true,
      "routes": [{ "pattern": "staging.homesuite.info", "custom_domain": true }],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "vars": {
        "GOOGLE_CLIENT_ID": "207614895482-6j7lq0k3g85r6s4pfkubuc3ieq7urg4b.apps.googleusercontent.com",
        "REQUIRE_RATE_LIMITS": "true"
      },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "31001",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "MUTATION_RATE_LIMITER",
          "namespace_id": "31002",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "d1_databases": [{
        "binding": "DB",
        "database_name": "homesuite-app-db-staging",
        "database_id": "7d270a78-adbb-45fc-b5fc-7550c547af68",
        "migrations_dir": "./migrations"
      }]
    }
  }
}
