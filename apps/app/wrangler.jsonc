{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "homesuite-app",
  "main": "./src/index.js",
  "compatibility_date": "2026-06-30",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "homesuite-app-local",
